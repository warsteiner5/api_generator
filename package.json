{
  "name": "api-generator",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generate": "plop",
    "ast:scan": "tsx tools/ast/scan-project.ts",
    "generate:ui:enums": "tsx tools/generators/ui/generate-enums.ts",
    "generate:ui:models": "tsx tools/generators/ui/generate-models.ts",
    "generate:ui:adapters": "tsx tools/generators/ui/generate-adapters.ts",
    "generate:ui:repositories": "tsx tools/generators/ui/generate-repositories.ts",
    "generate:ui": "npm run generate:ui:enums && npm run generate:ui:models && npm run generate:ui:adapters && npm run generate:ui:repositories"
  },
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.0",
    "@angular/cli": "^17.3.0",
    "@angular/compiler-cli": "^17.3.0",
    "@types/node": "^20.11.24",
    "plop": "^4.0.1",
    "ts-morph": "^23.0.0",
    "tsx": "^4.7.2",
    "typescript": "~5.4.2"
  }
}
